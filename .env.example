# YouTube Data API v3 (pytchatフォールバック用)
YOUTUBE_API_KEY=

# Anthropic Claude (オプション)
ANTHROPIC_API_KEY=

# OpenAI (オプション)
OPENAI_API_KEY=

# Google Custom Search JSON API (Web検索・任意)
#   APIキー: https://console.cloud.google.com/ で Custom Search API を有効化
#   検索エンジンID: https://programmablesearchengine.google.com/ で「ウェブ全体を検索」を作成
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Brave Search API (Web検索・任意。Googleの代わりに使える)
BRAVE_SEARCH_API_KEY=
